# Qdrant. "memory" keeps vectors inside the API process (tests and local eval).
# Compose overrides this to http://qdrant:6333.
QDRANT_URL=memory
QDRANT_COLLECTION=ragship

# Embeddings. The default hash provider is offline and does not download a model.
# Other providers: sentence-transformers, openai
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=
EMBEDDING_DIM=384

# Chat completions. Leave OPENAI_BASE_URL empty for extractive answers (no API key).
# OpenAI: https://api.openai.com/v1
# Ollama from Compose: http://ollama:11434/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=
MODEL=

# Optional force: extractive or openai. Empty follows OPENAI_BASE_URL.
LLM_PROVIDER=

CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
HOST=0.0.0.0
PORT=8091
